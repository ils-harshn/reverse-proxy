# Upstream site/API to proxy (full URL; path prefix is optional)
BASE_URL=https://httpbin.org

# Client-facing URL of this proxy (set to your PythonAnywhere web app URL in production)
PUBLIC_URL=https://YOURUSERNAME.pythonanywhere.com

# httpx trust_env=False when true — do not route BASE_URL requests through host proxy env
IGNORE_ENV=true

UPSTREAM_TIMEOUT=60

# Local development only (uvicorn)
HOST=127.0.0.1
PORT=8080